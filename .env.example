# FastAPI settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_BCRYPT_ROUNDS=12

# Database settings (Day 5 local Postgres)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=address_parser
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5432/address_parser
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ALLOW_METHODS=["GET","POST","OPTIONS"]
CORS_ALLOW_HEADERS=["Authorization","Content-Type","Accept"]
AUTH_BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Day 9 embeddings settings
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=all-MiniLM-L6-v2
EMBEDDINGS_DIMENSION=384
EMBEDDINGS_API_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_TIMEOUT_SECONDS=30
EMBEDDINGS_FALLBACK_ENABLED=true

# Day 10 LLM settings (fill in when model IDs and proxy URL are approved)
OPENAI_API_BASE_URL=
OPENAI_API_KEY=
LLM_GAP_FILL_MODEL=gpt-4o
LLM_SEARCH_MODEL=gpt-4o-search-preview
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Day 10 Serper settings (fill in when key is issued)
SERPER_API_KEY=
SERPER_API_BASE_URL=https://api.serper.dev
SERPER_TIMEOUT_SECONDS=15

# Local model settings (for local-first pipeline implementation)
LLM_LOCAL_PROVIDER=ollama
LLM_LOCAL_BASE_URL=
LLM_LOCAL_MODEL=
LLM_LOCAL_TIMEOUT_SECONDS=60

# Local geocoder settings
GEOCODER_PROVIDER=none
GEOCODER_BASE_URL=
GEOCODER_TIMEOUT_SECONDS=15

# If true, local-only providers are preferred over remote providers.
USE_LOCAL_MODELS_ONLY=false

# Day 10 cost estimator (GPT-4o public list pricing per 1k tokens)
COST_INPUT_PER_1K_TOKENS=0.005
COST_OUTPUT_PER_1K_TOKENS=0.015

# Corporate proxy / CA bundle (set for AKS / on-prem environments)

HTTP_PROXY=http://cso.proxy.att.com:8080/
HTTPS_PROXY=http://cso.proxy.att.com:8080/
NO_PROXY="localhost,127.0.0.1,::1,.att.com,.sbc.com,.azmk8s.io,api.github.com"
SSL_CERT_FILE=
REQUESTS_CA_BUNDLE=C:\Users\rn7279\certs\ATTINTERNALROOTv2.crt
$env:NODE_EXTRA_CA_CERTS="C:\Users\rn7279\certs\ATTINTERNALROOTv2.crt"